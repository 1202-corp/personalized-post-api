# Core API — environment variables
# When running via docker-compose from the repository root, these are provided by the root .env and compose.
# When running locally inside api/, copy this file to .env and fill in the values (same variable names as root .env).

# Server
PORT=8000

# Mock mode: if true, all endpoints return mock data (no DB/Redis). Set to false when real backend is connected.
USE_MOCK=true

# Database (used when USE_MOCK=false). When running in Docker from root: postgres:5432; locally: localhost with POSTGRES_PORT.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ppp_db
POSTGRES_PORT=5432
# Example for local: postgresql://postgres:postgres@localhost:5432/ppp_db
DATABASE_URL=

# Redis (used when USE_MOCK=false). When running in Docker from root: redis:6379; locally: localhost:6379.
REDIS_URL=redis://localhost:6379/0

# ML Service URL (for proxy when USE_MOCK=false)
ML_SERVICE_URL=http://localhost:8002

# Default training channels (comma-separated @usernames)
DEFAULT_TRAINING_CHANNELS=@durov,@telegram

# Admin auth (JWT and login)
JWT_SECRET=your-secret-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
